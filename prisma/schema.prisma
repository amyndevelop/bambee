generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"

}
model User {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 sessionVersion Int @default(0)
 role String @default("USER")
 timezone String @default("America/Argentina/Buenos_Aires")
 preferences Json @default("{}")
 createdAt DateTime @default(now())
 pregnancies Pregnancy[]
 memberships PregnancyMember[]
 notifications Notification[]
 files UploadedFile[]
 tokens ActionToken[]
 consents ConsentRecord[]
 assignedPreparations Task[] @relation("PreparationAssignee")
 nameChoices BabyNameChoice[]
 shareCards ShareCard[]
 medicalQuestions MedicalQuestion[]
 timelapses BellyTimelapse[]
 contractionSessions ContractionSession[]
}
model Pregnancy {
 id String @id @default(cuid())
 ownerId String
 owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
 babyName String?
 partnerName String?
 dueDate DateTime @db.Date
 datingSource String
 archived Boolean @default(false)
 createdAt DateTime @default(now())
 members PregnancyMember[]
 datingHistory PregnancyDatingHistory[]
 entries Entry[]
 appointments Appointment[]
 tasks Task[]
 invitations Invitation[]
 preparationCategories PreparationCategory[]
 nameChoices BabyNameChoice[]
 shareCards ShareCard[]
 medicalQuestions MedicalQuestion[]
 timelapses BellyTimelapse[]
 contractionSessions ContractionSession[]
 @@index([ownerId,archived])
}
model PregnancyMember {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 appointments Boolean @default(false)
 tasks Boolean @default(false)
 names Boolean @default(false)
 questions Boolean @default(false)
 cards Boolean @default(false)
 @@unique([pregnancyId,userId])
}
model PregnancyDatingHistory {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 dueDate DateTime @db.Date
 source String
 createdAt DateTime @default(now())
}
model Entry {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 attachments EntryAttachment[]
 kind String
 title String
 text String
 mood String?
 date DateTime @db.Date
 gestationalDays Int
 fileId String? @unique
 file UploadedFile? @relation(fields:[fileId],references:[id],onDelete:SetNull)
 appointmentId String?
 appointment Appointment? @relation(fields:[appointmentId],references:[id],onDelete:SetNull)
 createdAt DateTime @default(now())
 @@index([pregnancyId,kind,date])
}
model Appointment {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 title String
 type String
 at DateTime
 professional String
 location String
 address String?
 notes String
 completed Boolean @default(false)
 reminders AppointmentReminder[]
 entries Entry[]
 medicalQuestions MedicalQuestion[]
 @@index([pregnancyId,at])
}
model AppointmentReminder {
 id String @id @default(cuid())
 appointmentId String
 appointment Appointment @relation(fields:[appointmentId],references:[id],onDelete:Cascade)
 dueAt DateTime
 sentAt DateTime?
 @@index([sentAt,dueAt])
}
model UploadedFile {
 id String @id @default(cuid())
 ownerId String
 owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
 key String @unique
 mime String
 medical Boolean @default(false)
 size Int
 name String
 entry Entry?
 attachment EntryAttachment?
 timelapse BellyTimelapse?
 shareCards ShareCard[]
 graphic GraphicAsset?
 createdAt DateTime @default(now())
}
model Notification {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 category String
 title String
 read Boolean @default(false)
 dedupe String @unique
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}
model Invitation {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 email String
 tokenHash String @unique
 appointments Boolean
 tasks Boolean @default(false)
 expiresAt DateTime
 acceptedAt DateTime?
}
model ActionToken {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 hash String @unique
 expiresAt DateTime
}
model ConsentRecord {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 version String
 createdAt DateTime @default(now())
}
model WeeklyDevelopment {
 editorialPublished Boolean @default(false)
 editorialPublicationRelease String?
 trimester Int?
 lengthCm Float?
 lengthMinCm Float?
 lengthMaxCm Float?
 measurementMethod String?
 developmentHighlights String[] @default([])
 maternalChanges String?
 fruitImage String?
 fruitImageIsPlaceholder Boolean @default(false)
 sourceNames String[] @default([])
 reviewStatus String @default("PENDING_REVIEW")
 contentVersion String?
 id String @id @default(cuid())
 week Int @unique
 title String
 summary String
 details String
 fruit String
 measurement String
 referenceUrls String[]
 illustrationId String?
 illustration GraphicAsset? @relation(fields:[illustrationId],references:[id],onDelete:SetNull)
 reviewedBy String?
 reviewedAt DateTime?
 published Boolean @default(false)
 updatedAt DateTime @updatedAt
}
model AuditLog {
 id String @id @default(cuid())
 actorId String?
 action String
 targetId String?
 createdAt DateTime @default(now())
}
model LoginAttempt {
 key String @id
 count Int
 resetAt DateTime
}

model GraphicAsset {
 id String @id @default(cuid())
 slug String @unique
 fileId String @unique
 file UploadedFile @relation(fields:[fileId],references:[id],onDelete:Cascade)
 published Boolean @default(false)
 createdAt DateTime @default(now())
 weeks WeeklyDevelopment[]
}

model Task {
 notes String @default("")
 position Int @default(0)
 templateItemKey String?
 categoryId String?
 category PreparationCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
 assigneeId String?
 assignee User? @relation("PreparationAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
 reminderAt DateTime?
 remindedAt DateTime?
 @@unique([pregnancyId,templateItemKey])
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 title String
 dueDate DateTime? @db.Date
 completed Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([pregnancyId,completed])
}

model EntryAttachment {
 id String @id @default(cuid())
 entryId String
 entry Entry @relation(fields:[entryId],references:[id],onDelete:Cascade)
 fileId String @unique
 file UploadedFile @relation(fields:[fileId],references:[id],onDelete:Cascade)
 @@index([entryId])
}

model PreparationCategory {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 title String
 templateKey String?
 position Int @default(0)
 tasks Task[]
 @@unique([pregnancyId,templateKey])
 @@index([pregnancyId,position])
}
model ToolTemplate {
 id String @id @default(cuid())
 slug String @unique
 kind String
 title String
 config Json
 published Boolean @default(false)
 updatedAt DateTime @updatedAt
 @@index([kind,published])
}
model BabyName {
 id String @id @default(cuid())
 name String
 normalized String @unique
 gender String
 origin String?
 meaning String?
 variants String[] @default([])
 pronunciation String?
 source String
 sourceUrl String?
 verification String @default("PENDING")
 choices BabyNameChoice[]
 updatedAt DateTime @updatedAt
 @@index([gender,origin])
}
model BabyNameChoice {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 nameId String
 name BabyName @relation(fields:[nameId],references:[id],onDelete:Cascade)
 favorite Boolean @default(false)
 vote String?
 shared Boolean @default(false)
 finalist Boolean @default(false)
 note String @default("")
 @@unique([pregnancyId,userId,nameId])
 @@index([userId,pregnancyId])
}
model ShareCard {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 templateId String
 text String
 background String
 format String
 showGestation Boolean @default(false)
 shared Boolean @default(false)
 fileId String?
 file UploadedFile? @relation(fields:[fileId],references:[id],onDelete:SetNull)
 medicalConsent Boolean @default(false)
 illustration String @default("brand")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([pregnancyId,userId])
}
model MedicalQuestion {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 appointmentId String?
 appointment Appointment? @relation(fields:[appointmentId],references:[id],onDelete:SetNull)
 category String
 question String
 answer String @default("")
 answered Boolean @default(false)
 shared Boolean @default(false)
 reminder Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([pregnancyId,appointmentId,answered])
}
model BellyTimelapse {
 id String @id @default(cuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 config Json
 status String @default("DRAFT")
 progress Int @default(0)
 error String?
 outputFileId String? @unique
 outputFile UploadedFile? @relation(fields:[outputFileId],references:[id],onDelete:SetNull)
 startedAt DateTime?
 finishedAt DateTime?
 expiresAt DateTime?
 createdAt DateTime @default(now())
 @@index([status,createdAt])
 @@index([pregnancyId,userId])
}
model ContractionSession {
 id String @id @default(uuid())
 pregnancyId String
 pregnancy Pregnancy @relation(fields:[pregnancyId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 status String @default("ACTIVE")
 instructions String @default("")
 startedAt DateTime
 endedAt DateTime?
 records ContractionRecord[]
 @@index([pregnancyId,userId,startedAt])
}
model ContractionRecord {
 id String @id
 sessionId String
 session ContractionSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
 startedAt DateTime
 endedAt DateTime?
 note String @default("")
 @@index([sessionId,startedAt])
}
