DATABASE_URL=postgresql://bambee:CHANGE_ME@localhost:5432/bambee
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
APP_URL=http://localhost:3000
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=bambee-private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_URL=
MAIL_FROM=
# Autorización del programador externo; al menos 32 caracteres aleatorios
CRON_SECRET=

# Enable only after deploying the persistent private media worker (not in Vercel Functions).
MEDIA_WORKER_ENABLED=false
# Worker only; FFmpeg 6+ with libx264. Default: ffmpeg in PATH.
FFMPEG_PATH=ffmpeg
